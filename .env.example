# GEMINI_API_KEY: Required for server-side Gemini AI structured claim extraction.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Avalanche Fuji Testnet (Chain ID 43113)
AVALANCHE_FUJI_RPC_URL="https://api.avax-test.network/ext/bc/C/rpc"
STOCKPROOF_CONTRACT_ADDRESS="0x7F4c9E218A6b40D32E8819F5b12C4A03D9E8104B"

# Cloud SQL PostgreSQL (injected automatically when Cloud SQL is enabled)
SQL_HOST=""
SQL_PORT="5432"
SQL_USER=""
SQL_PASSWORD=""
SQL_DB_NAME=""
SQL_SOCKET_PATH=""
